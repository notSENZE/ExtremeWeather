<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SenzeExtremeWeather.Server</RootNamespace>
    <AssemblyName>SenzeExtremeWeather.Server</AssemblyName>
    <Authors>SENZE</Authors>
    <Company>SENZE</Company>
    <Product>Extreme Weather</Product>
    <Description>SPT server integration and release notification for Extreme Weather.</Description>
    <Version>1.3.10</Version>
    <AssemblyVersion>1.3.10.0</AssemblyVersion>
    <FileVersion>1.3.10.0</FileVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <LangVersion>11.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="SemanticVersioning">
      <HintPath>$(SptPath)\SPT_Runtime\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SptPath)\SPT_Runtime\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SptPath)\SPT_Runtime\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SptPath)\SPT_Runtime\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
